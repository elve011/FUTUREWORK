# ================= Django / App =================
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Dev 2 / Evidence database
DATABASE_URL=sqlite:///db.sqlite3
DB_SCHEMA=fw_evidence

# Dev 4 local database
FW_DATABASE_PATH=dev4.sqlite3

# ================= Hedera / HCS =================

# Dev 2 HCS integration
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_KEY_TYPE=ecdsa
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Dev 2 modes
FW_MODE=mock
FW_MODE_HCS=live
FW_MODE_MIRROR=live
FW_MODE_GITHUB=live

# Dev 4 independent modes
FW_MODE_PROJECT=mock
FW_MODE_EVENTS=mock
FW_MODE_HEDERA=mock
FW_MODE_SETTLEMENT=local
FW_MODE_EVIDENCE=local

# Dev 4 Hedera configuration
FW_HEDERA_NETWORK=testnet
FW_HEDERA_MIRROR_NODE_URL=
FW_HEDERA_PROJECT_REFERENCES={}
FW_HEDERA_TIMEOUT_SECONDS=5
FW_HEDERA_MAX_PAGES=3
FW_HEDERA_CACHE_SECONDS=15

# Optional real Hedera demo transfer credentials
# NEVER commit real values.
FW_HEDERA_DEMO_OPERATOR_ACCOUNT_ID=
FW_HEDERA_DEMO_OPERATOR_PRIVATE_KEY=
FW_HEDERA_DEMO_RECIPIENT_ACCOUNT_ID=

# ================= GitHub =================

# Dev 2
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=change-me

# Dev 4
FW_GITHUB_TOKEN=
FW_GITHUB_ALLOWED_REPOSITORIES=

# ================= Project / Agent =================

PROJECT_API_URL=http://localhost:8001
AGENT_API_URL=http://localhost:8004

LLM_API_KEY=
LLM_MODEL=
AUTO_VERIFY=1