DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FW_DATABASE_PATH=dev4.sqlite3

# Select each data source independently. The mini-project defaults to mock.
FW_MODE_PROJECT=mock
FW_MODE_EVENTS=mock
FW_MODE_HEDERA=mock
# For read-only Mirror Node mode, use testnet first; mainnet is opt-in.
# Project IDs map only to explicitly configured Hedera entity IDs. Example:
# {"FW-PROJECT-001":{"account_ids":["0.0.123"],"topic_ids":["0.0.456"],"token_ids":[],"contract_ids":[]}}
FW_HEDERA_NETWORK=testnet
# Optional HTTPS API base URL; must end in /api/v1 and match the selected network.
FW_HEDERA_MIRROR_NODE_URL=
FW_HEDERA_PROJECT_REFERENCES={}
FW_HEDERA_TIMEOUT_SECONDS=5
FW_HEDERA_MAX_PAGES=3
FW_HEDERA_CACHE_SECONDS=15
# Optional real demo transfers: testnet only; keep credentials out of source control.
# Configure these only in your local process environment. Never use a disclosed key.
FW_HEDERA_DEMO_OPERATOR_ACCOUNT_ID=
FW_HEDERA_DEMO_OPERATOR_PRIVATE_KEY=
FW_HEDERA_DEMO_RECIPIENT_ACCOUNT_ID=
FW_MODE_SETTLEMENT=local
# Evidence source: local synthetic test payloads or read-only GitHub API.
FW_MODE_EVIDENCE=local
# Required only for github mode; use a fine-grained token with read-only access.
FW_GITHUB_TOKEN=
# Required allowlist, comma separated owner/repository values.
FW_GITHUB_ALLOWED_REPOSITORIES=
