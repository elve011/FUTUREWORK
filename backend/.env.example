# ================= REAL HEDERA (testnet) =================
# 1) Create a free testnet account at https://portal.hedera.com  -> copy Account ID + private key
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_KEY_TYPE=ecdsa          # ecdsa = portal "HEX Encoded" key | der = key starting with 302e... | ed25519
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# 2) Sources running for real in your standalone module
FW_MODE=mock                   # default for anything not listed below
FW_MODE_HCS=live
FW_MODE_MIRROR=live
FW_MODE_GITHUB=live
# FW_MODE_LLM=live             # needs LLM_API_KEY + LLM_MODEL, otherwise deterministic scoring is used anyway
# Dev 1 / Dev 4 modules: switch to live at integration (J11-J12)
# FW_MODE_PROJECT=live
# FW_MODE_EVENTS=live

# ================= GitHub =================
GITHUB_TOKEN=                 # PAT with repo + admin:repo_hook (to create the webhook and backfill)
GITHUB_WEBHOOK_SECRET=change-me

# ================= App =================
DJANGO_SECRET_KEY=change-me
DEBUG=1
DATABASE_URL=sqlite:///db.sqlite3
DB_SCHEMA=fw_evidence
PROJECT_API_URL=http://localhost:8001
AGENT_API_URL=http://localhost:8004
LLM_API_KEY=
LLM_MODEL=
AUTO_VERIFY=1
